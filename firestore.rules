rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Globals & Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id.size() <= 128 && id.matches('^[a-zA-Z0-9_@.+-]+$');
    }

    // Default Lockout (Enterprise Least-Privilege Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- COLLECTION: users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Creating is allowed only for current user completing registration, restricting role to non-privileged 'viewer' or 'user'
      allow create: if isCurrentUser(userId) 
                    && isValidId(userId)
                    && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'viewer' || request.resource.data.role == 'user');
                    
      // Updates are restricted to current user (themselves) and role cannot be self-escalated
      allow update: if isCurrentUser(userId) 
                    && isValidId(userId)
                    && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == resource.data.role);
                    
      allow delete: if false; // Users cannot delete user records directly
    }

    // --- COLLECTION: project_stats ---
    match /project_stats/{projectId} {
      allow read: if isSignedIn();
      // Server / Admin-only writes for project stats
      allow create, update, delete: if false;
    }

    // --- COLLECTION: audit_logs ---
    match /audit_logs/{logId} {
      // Audit logs readable only by owner or admin
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow create: if isSignedIn() 
                    && isValidId(logId) 
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Strict audit trail immutability
    }

    // --- PROSPECTIVE SECURITY GROUPS (Preventative Lockdown) ---
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(projectId) && (request.auth.token.admin == true || resource.data.ownerId == request.auth.uid);
    }

    match /analytics/{analyticsId} {
      allow read: if isSignedIn();
      allow write: if false; // Derived statistics owned by server
    }

    match /settings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(settingsId) && request.auth.token.admin == true;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(reportId);
    }
  }
}
